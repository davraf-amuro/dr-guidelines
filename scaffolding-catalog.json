{
  "schemaVersion": 1,
  "updatedAt": "2026-08-08",
  "defaults": {
    "dotnetFramework": "net10.0",
    "solutionFormat": "slnx",
    "sourcePath": "src",
    "testPath": "test",
    "namePattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
  },
  "projectTypes": [
    {
      "id": "minimal-api",
      "label": "Minimal API (.NET 10)",
      "kind": "dotnet",
      "dotnetTemplate": "web",
      "targetPath": "src",
      "defaultNameSuffix": ".api",
      "suggestedPackages": ["dr-dotnet-backend", "dr-minimalapi"],
      "optionalPackages": ["dr-efdb"],
      "docs": "docs/scaffolding-minimal-api.md",
      "notes": "Template 'web' (ASP.NET Core vuoto), non 'webapi': la struttura Endpoints/ parte dal template vuoto."
    },
    {
      "id": "worker-service",
      "label": "Windows Service / Worker (.NET 10)",
      "kind": "dotnet",
      "dotnetTemplate": "worker",
      "targetPath": "src",
      "defaultNameSuffix": ".service",
      "suggestedPackages": ["dr-dotnet-backend", "dr-winsvc"],
      "optionalPackages": ["dr-efdb"],
      "docs": "docs/scaffolding-windows-service.md",
      "notes": "Un file per worker in Workers/, ciascuno erede di BackgroundService."
    },
    {
      "id": "classlib",
      "label": "Class Library (.NET 10)",
      "kind": "dotnet",
      "dotnetTemplate": "classlib",
      "targetPath": "src",
      "defaultNameSuffix": ".core",
      "suggestedPackages": ["dr-dotnet-backend"],
      "optionalPackages": [],
      "docs": null,
      "notes": "Codice condiviso tra API e worker della stessa solution."
    },
    {
      "id": "xunit-test",
      "label": "Progetto di test xUnit (.NET 10)",
      "kind": "dotnet",
      "dotnetTemplate": "xunit",
      "targetPath": "test",
      "defaultNameSuffix": ".tests",
      "suggestedPackages": [],
      "optionalPackages": [],
      "docs": null,
      "notes": "Va in test/, non in src/. I template dotnet new scrivono UTF-8 con BOM: serve 'dotnet format' in scrittura prima del primo push."
    },
    {
      "id": "vue-fe",
      "label": "Frontend Vue 3 + Vite + TypeScript",
      "kind": "node",
      "nodeScaffolder": {
        "command": "npm create vue@latest",
        "argsTemplate": "<nome> -- --ts --router --pinia --eslint --prettier",
        "postInstall": "npm install"
      },
      "targetPath": ".",
      "defaultNameSuffix": "-fe",
      "suggestedPackages": ["dr-fe"],
      "optionalPackages": [],
      "docs": null,
      "notes": "I flag di create-vue sono booleani puri: '--vitest=false' fa fallire il comando. Va creato PRIMA dell'install del core, perche' scrive un proprio .editorconfig/.gitignore/.gitattributes. Lo script 'lint' generato usa --fix, quindi non vale come gate di verifica."
    }
  ],
  "packages": [
    {
      "name": "dr-guidelines",
      "repo": "davraf-amuro/dr-guidelines",
      "isCore": true,
      "dependencies": [],
      "appliesTo": ["any"],
      "description": "Core: instructions e skill trasversali, file di configurazione radice, sezione CLAUDE.md."
    },
    {
      "name": "dr-dotnet-backend",
      "repo": "davraf-amuro/dr-dotnet-backend",
      "isCore": false,
      "dependencies": [],
      "appliesTo": ["dotnet"],
      "description": "Base backend .NET condivisa: skill dr-audit-api."
    },
    {
      "name": "dr-minimalapi",
      "repo": "davraf-amuro/dr-minimalapi",
      "isCore": false,
      "dependencies": ["dr-dotnet-backend"],
      "appliesTo": ["dotnet"],
      "description": "Architettura Minimal API, prompt endpoint e scaffolding CRUD."
    },
    {
      "name": "dr-winsvc",
      "repo": "davraf-amuro/dr-winsvc",
      "isCore": false,
      "dependencies": ["dr-dotnet-backend"],
      "appliesTo": ["dotnet"],
      "description": "Architettura Windows Service / Worker."
    },
    {
      "name": "dr-efdb",
      "repo": "davraf-amuro/dr-efdb",
      "isCore": false,
      "dependencies": [],
      "appliesTo": ["dotnet"],
      "description": "EF Core: provider database e resilienza in avvio.",
      "mcpSuggestion": "db-schema"
    },
    {
      "name": "dr-fe",
      "repo": "davraf-amuro/dr-fe",
      "isCore": false,
      "dependencies": [],
      "appliesTo": ["node"],
      "description": "Organizzazione frontend e skill dr-audit-fe."
    },
    {
      "name": "dr-devops",
      "repo": "davraf-amuro/dr-devops",
      "isCore": false,
      "dependencies": [],
      "appliesTo": ["any"],
      "description": "Docker Swarm, Portainer, CI/CD GitLab."
    }
  ]
}
